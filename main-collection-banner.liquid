{{ 'ritual-core.css' | asset_url | stylesheet_tag }}

<div class="section-{{ section.id }}-padding" style="background-color: var(--background-dark, #121212); position: relative; overflow: hidden;">
  <section class="collection-hero" style="position: relative; min-height: 40vh; display: flex; align-items: center; justify-content: center; text-align: center; padding: 8vw 4vw;">
    {% if section.settings.show_image and collection.image %}
      <div style="position: absolute; inset: 0; z-index: 1;">
        {%- assign escaped_title = collection.title | escape -%}
        {{ collection.image | image_url: width: 2000 | image_tag: style: 'width: 100%; height: 100%; object-fit: cover; opacity: 0.35;', alt: escaped_title }}
      </div>
    {% endif %}

    <div style="position: relative; z-index: 2; max-width: 900px; margin: 0 auto;">
      <h1 class="heading-grotesque" style="font-size: clamp(3rem, 6vw, 6rem); line-height: 0.95; margin-bottom: 1.5rem; color: var(--text-linen, #f0ebe1);">
        {{ collection.title | escape }}
      </h1>
      {% if section.settings.show_description and collection.description != blank %}
        <div style="font-size: clamp(1.1rem, 1.8vw, 1.4rem); line-height: 1.5; opacity: 0.75; color: rgba(240, 235, 225, 0.75); max-width: 700px; margin: 0 auto;">
          {{ collection.description }}
        </div>
      {% endif %}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Collection Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show collection image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show collection description",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Collection Banner"
    }
  ]
}
{% endschema %}
