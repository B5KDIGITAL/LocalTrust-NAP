{{ 'ritual-core.css' | asset_url | stylesheet_tag }}


<style>
  .collection-banner-container {
    background-color: var(--background-dark, #121212);
    position: relative;
    overflow: hidden;
  }
  .collection-hero {
    position: relative;
    min-height: 40vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 8vw 4vw;
  }
  .collection-hero__image-container {
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .collection-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.35;
  }
  .collection-hero__content {
    position: relative;
    z-index: 2;
    max-width: 900px;
    margin: 0 auto;
  }
  .collection-hero__title {
    font-size: clamp(3rem, 6vw, 6rem);
    line-height: 0.95;
    margin-bottom: 1.5rem;
    color: var(--text-linen, #f0ebe1);
  }
  .collection-hero__description {
    font-size: clamp(1.1rem, 1.8vw, 1.4rem);
    line-height: 1.5;
    opacity: 0.75;
    color: rgba(240, 235, 225, 0.75);
    max-width: 700px;
    margin: 0 auto;
  }
</style>

<div class="section-{{ section.id }}-padding collection-banner-container">
  <section class="collection-hero">
    {% if section.settings.show_image and collection.image %}
      <div class="collection-hero__image-container">
        {%- assign escaped_title = collection.title | escape -%}
        {{ collection.image | image_url: width: 2000 | image_tag: class: 'collection-hero__image', alt: escaped_title }}
      </div>
    {% endif %}

    <div class="collection-hero__content">
      <h1 class="heading-grotesque collection-hero__title">
        {{ collection.title | escape }}
      </h1>
      {% if section.settings.show_description and collection.description != blank %}
        <div class="collection-hero__description">
          {{ collection.description }}
        </div>
      {% endif %}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Collection Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show collection image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show collection description",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Collection Banner"
    }
  ]
}
{% endschema %}
